// Cloudflare Workers config: serves this repo as a static site, no build step.
// Needed so builds know what to upload.
{
  "name": "dumpy",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./"
  },
  // Pull request preview builds run "wrangler preview", which needs this block (it can stay empty).
  "previews": {}
}
